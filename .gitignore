.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# large or regenerable artefacts
data/
outputs/
runs/

# trained checkpoints stay local; only the exported model used by the application is shared
models/*
!models/redactner-best/

# generated sample outputs (inputs are committed)
samples/*_redacted.docx

# desktop application: build environment and PyInstaller output (see packaging/)
.venv-build/
build/
dist/

# never committed: secrets, logs, and files of editors, tools and the operating system
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.log
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
